# --- PayPal sandbox (https://developer.paypal.com/dashboard/applications/sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox *Personal* account email that receives demo payouts (Dashboard -> Sandbox -> Accounts)
DEMO_FREELANCER_EMAIL=
# Optional: webhook ID from the dashboard (enables signature verification on /api/paypal/webhook)
PAYPAL_WEBHOOK_ID=

# --- LLM (any one key; free tiers work) ---
# Groq: https://console.groq.com/keys  (default model openai/gpt-oss-120b)
GROQ_API_KEY=
# Gemini: https://aistudio.google.com/apikey  (default gemini-2.5-flash; can see uploaded images)
GEMINI_API_KEY=
# OpenRouter: https://openrouter.ai/keys  (default openai/gpt-oss-120b:free)
OPENROUTER_API_KEY=
# Optional: force a provider (groq | gemini | openrouter) and/or a model
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b

# --- Database ---
# Neon Postgres connection string (free tier at https://neon.com). Leave empty locally to use
# an embedded PGlite database stored in ./.data (zero setup).
DATABASE_URL=

# Public base URL (used for links + so the AI verifier can reach the sample deliverable)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Platform fee kept by Fairhold on each release, in percent
PLATFORM_FEE_PERCENT=3

# Optional: enables POST /api/admin/reset?key=<RESET_KEY> to clear all demo data
RESET_KEY=
